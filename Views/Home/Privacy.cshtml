@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="workspace-page privacy-page">

    <div class="workspace-panel">

        <!-- Page Header -->
        <div class="mb-4">
            <div class="privacy-label">DEVNOTES AI · TRANSPARENCY</div>

            <h1 class="fw-bold mt-2 mb-2">Privacy Policy</h1>

            <p class="text-muted mb-0">
                Understand how DevNotes AI processes your code,
                uses AI services, and stores your analysis history.
            </p>
        </div>

        <hr class="my-4" />

        <!-- Introduction -->
        <section class="privacy-section">
            <h4>01. Privacy Overview</h4>

            <p>
                DevNotes AI is a code analysis application designed to
                help developers understand, analyze, and document source
                code using artificial intelligence.
            </p>

            <p>
                This page explains what information the application
                processes and how analysis history is stored.
            </p>
        </section>

        <!-- Source Code -->
        <section class="privacy-section">
            <h4>02. Source Code & Uploaded Files</h4>

            <p>
                When you use Explain Code, Analyze Functions, or
                Generate Documentation, the source code you submit
                is processed to generate the requested result.
            </p>

            <ul>
                <li>Code can be entered directly into the workspace.</li>
                <li>Supported files include C#, Java, and Python source files.</li>
                <li>Submitted code may be sent to the configured AI service.</li>
                <li>Source code and generated results are saved in analysis history.</li>
            </ul>
        </section>

        <!-- AI Processing -->
        <section class="privacy-section">
            <h4>03. AI Processing</h4>

            <p>
                DevNotes AI uses Google's Gemini API to provide code
                explanations, function analysis, and documentation.
                Submitted code and relevant requests are sent to the
                configured AI service for processing.
            </p>

            <p>
                The handling and retention of information by the
                external AI provider are subject to that provider's
                applicable terms and privacy policies.
            </p>
        </section>

        <!-- History -->
        <section class="privacy-section">
            <h4>04. Analysis History & Database</h4>

            <p>
                To let you review previous work, DevNotes AI stores
                analysis records in its SQL Server database.
            </p>

            <ul>
                <li>Analysis type</li>
                <li>Programming language</li>
                <li>Submitted source code</li>
                <li>AI-generated result</li>
                <li>Date and time of the analysis</li>
            </ul>

            <p>
                The History page displays the latest 50 saved records.
                This limit controls what is displayed; it does not
                mean older records are automatically deleted.
            </p>
        </section>

        <!-- Security -->
        <section class="privacy-section">
            <h4>05. Security & Your Responsibility</h4>

            <p>
                Avoid submitting passwords, API keys, access tokens,
                personal information, or confidential company code.
                Only submit code you are authorized to share with an
                external AI service.
            </p>

            <p>
                Protecting database access and API credentials is
                important. No application or online service can
                guarantee absolute security.
            </p>
        </section>

        <!-- Limitations -->
        <section class="privacy-section">
            <h4>06. AI Limitations</h4>

            <p>
                AI-generated explanations and documentation may
                occasionally be incomplete or incorrect. Always
                review generated content before relying on it,
                especially in production or security-sensitive code.
            </p>
        </section>

        <!-- Project Information -->
        <section class="privacy-section mb-0">
            <h4>07. About This Policy</h4>

            <p>
                This policy describes the current data-handling
                behavior of DevNotes AI. If the application's
                processing, storage, or external services change,
                this page should be updated accordingly.
            </p>

            <div class="privacy-footer mt-4">
                <span>DEVNOTES AI</span>
                <span>Built for smarter code understanding.</span>
            </div>
        </section>

    </div>
</div>
